# ============================================
# Alexandria Library Configuration (Example)
# ============================================

# --- Librarian Settings ---
LIBRARIAN_PORT=8090

# --- Admin account ---
# No default password: on first run, POST /api/setup creates the admin.

# --- Data and vaults ---
# Markdown folders (Obsidian, Lokus, Otterly) under VAULTS_DIR can be added as sources
VAULTS_DIR=./vaults
# Browser apps that may call the API (comma separated)
ALX_CORS_ORIGINS=http://localhost:5173

# --- Model endpoint used by /v1/* (any OpenAI-compatible API) ---
MODEL_BASE_URL=
MODEL_API_KEY=

# --- Model Configuration ---

# Main Model (primary AI for agent)
MAIN_MODEL_TYPE=local
MAIN_MODEL_URL=http://localhost:11434
MAIN_MODEL_NAME=llama3:70b

# Fallback Model (backup if main fails - OpenRouter example)
FALLBACK_MODEL_TYPE=openrouter
FALLBACK_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FALLBACK_MODEL_NAME=google/gemini-2.0-flash-exp:free

# --- MCP/World Builder Configuration ---
# Format: MCP_<name>_URL=<github-repo-url>

# LegendKeeper MCP (default)
MCP_LEGENDKEEPER_URL=https://github.com/chase-roohms/legendkeeper-mcp
MCP_LEGENDKEEPER_API_KEY=your_legendkeeper_api_key_here

# Kanka MCP (optional)
# MCP_KANKA_URL=https://github.com/kanka/mcp
# MCP_KANKA_API_KEY=your_kanka_api_key_here

# Generic MCP (optional - for any custom MCP)
# MCP_GENERIC_URL=https://github.com/your-org/your-mcp
# MCP_GENERIC_API_KEY=your_generic_api_key_here

# --- Default MCP Selection ---
DEFAULT_MCP=legendkeeper

# --- Docker Compose Settings ---
MCP_AUTH_TOKEN=generate_with_openssl_rand_hex_32
