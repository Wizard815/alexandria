# nginx in front of Alexandria (published on 127.0.0.1:8090).
# Set ALX_TRUST_PROXY=1 and ALX_PUBLIC_URL=https://alexandria.example.com.
server {
    listen 443 ssl;
    http2 on;
    server_name alexandria.example.com;
    ssl_certificate     /etc/letsencrypt/live/alexandria.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alexandria.example.com/privkey.pem;

    client_max_body_size 20m;   # page saves, item images, backups

    # Live updates (Server-Sent Events): no buffering, long reads.
    location ~ ^/api/worlds/[^/]+/events$ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server {
    listen 80;
    server_name alexandria.example.com;
    return 301 https://$host$request_uri;
}
