# Your domain, pointed at this server (A/AAAA record). Caddy gets the certificate.
ALX_DOMAIN=alexandria.example.com

# Markdown vaults the admin may add as sources (read-only inside the container)
VAULTS_DIR=./vaults

# Requests per minute per IP for the API and MCP (0 turns it off)
ALX_RATE_LIMIT=900

# Model endpoint for AI features (any OpenAI-compatible API)
MODEL_BASE_URL=
MODEL_API_KEY=
# LOCAL_LLM_URL=http://host.docker.internal:11434

# Local MCP servers the librarian may start (JSON). Leave empty in Docker
# unless you add the server's runtime to the image.
ALX_MCP_STDIO=

# Only with --profile legendkeeper
LK_MCP_TOKEN=
LEGENDKEEPER_API_KEY=

# Base image for the build; a mirror helps if Docker Hub rate-limits you
# NODE_IMAGE=mirror.gcr.io/library/node:24-alpine
