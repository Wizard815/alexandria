# Alexandria Librarian - Environment Variables

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROXY_PORT=8080
EMBEDDING_MODEL=text-embedding-3-small

# Local LLM (Argos, Ollama, etc.)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3:70b

# MCP World Builder APIs
# Kanka MCP
MCP_KANKA_URL=http://localhost:3333

# LegendKeeper MCP (default - main world builder)
MCP_LEGENDKEEPER_URL=http://localhost:3334

# Generic world builder API (for other MCP servers)
MCP_GENERIC_URL=http://localhost:3335

# Embedding Database
EMBEDDING_DB_URL=http://localhost:8081
