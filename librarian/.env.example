# Alexandria librarian

LIBRARIAN_PORT=8090

# Where the database, the per-world Markdown mirror and git sources live
ALX_DATA_DIR=./data

# Folders under this path can be added as "vault" sources (read-only)
ALX_VAULTS_DIR=./vaults

# Browser apps on other origins that may call the API (comma separated)
ALX_CORS_ORIGINS=http://localhost:5173

# Model endpoint (any OpenAI-compatible API: OpenAI, Argos, Ollama, LM Studio)
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# Or a local server; /v1 is added for you
# LOCAL_LLM_URL=http://localhost:11434
