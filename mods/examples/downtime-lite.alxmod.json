{
  "kit": 2,
  "id": "downtime-lite",
  "name": "Downtime lite",
  "version": "1.0.0",
  "author": "Wizard",
  "summary": "Downtime activities by tier. The DM presses Downtime when a day passes; each player keeps working, starts something or skips. A task is done when its days are in.",
  "alexandria": ">=0.1",
  "targets": { "builtFor": ["sheet"], "worksWith": ["chat"] },
  "records": {
    "activity": {
      "label": "Activity", "plural": "Activities",
      "fields": {
        "name": "text",
        "tier": { "type": "enum", "values": ["common", "uncommon", "rare", "very rare", "legendary"], "label": "Tier" },
        "days": { "type": "int", "min": 1, "max": 365, "label": "Days" },
        "reward": "text?"
      },
      "seed": [
        { "name": "Work a trade", "tier": "common", "days": 1, "reward": "5 gp" },
        { "name": "Carouse", "tier": "uncommon", "days": 3, "reward": "A useful contact" },
        { "name": "Study a spell", "tier": "rare", "days": 7 },
        { "name": "Train a skill", "tier": "very rare", "days": 30, "reward": "A new proficiency" },
        { "name": "Build a stronghold", "tier": "legendary", "days": 90 }
      ]
    },
    "task": {
      "label": "Task", "owned": true, "title": "activity",
      "fields": {
        "activity": { "type": "ref", "ref": "activity", "label": "Activity" },
        "done": { "type": "int", "default": 0, "min": 0, "label": "Days done" },
        "goal": { "type": "int", "label": "Days needed" },
        "status": { "type": "enum", "values": ["open", "done", "dropped"], "default": "open", "label": "Status" }
      }
    }
  },
  "recordActions": [
    { "id": "start", "label": "Start", "by": "owner", "record": "task", "do": "create", "ask": ["activity"], "copy": { "via": "activity", "fields": { "goal": "days" } }, "effect": { "chat": "{name} starts {activity.name}." } },
    { "id": "work", "label": "Keep working", "by": "owner", "record": "task", "do": "set", "where": { "status": "open" } },
    { "id": "adjust", "label": "Add or take days", "by": "dm", "record": "task", "do": "add", "field": "done", "amount": "ask" },
    { "id": "drop", "label": "Drop", "by": "any", "record": "task", "do": "remove", "where": { "status": "open" } },
    { "id": "new-activity", "label": "New activity", "by": "any", "record": "activity", "do": "create", "ask": ["name", "tier", "days", "reward"] }
  ],
  "timers": [
    { "id": "day", "record": "task", "on": "prompt:downtime-day", "where": { "status": "open" }, "field": "done", "add": 1, "goal": "goal",
      "done": { "set": { "status": "done" }, "chat": "{name} finished {activity.name}! {activity.reward}" } }
  ],
  "prompts": [
    { "id": "downtime-day", "button": "Downtime", "title": "A downtime day", "text": "How do you spend the day?",
      "choices": [{ "label": "Keep working", "action": "work" }, { "label": "Start something", "action": "start" }, { "label": "Skip the day", "skip": true }] }
  ],
  "views": [
    { "id": "tasks", "title": "Downtime", "record": "task", "place": "dm", "columns": ["activity", "done", "goal", "status"], "actions": ["adjust", "drop"], "groupByPlayer": true },
    { "id": "activities", "title": "Activities", "record": "activity", "place": "dm", "columns": ["name", "tier", "days", "reward"] },
    { "id": "mine", "title": "My downtime", "record": "task", "place": "sheet", "columns": ["activity", "done", "goal"], "where": { "status": "open" }, "actions": ["drop"] }
  ],
  "rules": [{ "term": "Downtime (house rule)", "text": "When a day passes between adventures the DM calls a downtime day. Keep working on a task, start a new activity, or skip. Each activity takes days by its tier; when the days are in, you get its reward." }]
}
