{
  "kit": 2,
  "id": "crafting-projects",
  "name": "Crafting projects",
  "version": "1.0.0",
  "author": "Alexandria",
  "summary": "Players start crafting projects (an item, its cost and days of work) that move forward on each long rest or when the GM adds days.",
  "alexandria": ">=0.1",
  "targets": {
    "builtFor": [],
    "worksWith": [
      "sheet",
      "inventory",
      "assistant"
    ]
  },
  "records": {
    "project": {
      "label": "Project",
      "plural": "Projects",
      "owned": true,
      "title": "item",
      "fields": {
        "item": "text",
        "tool": {
          "type": "text",
          "label": "Tool"
        },
        "cost": {
          "type": "int",
          "default": 0,
          "min": 0,
          "label": "Gold paid"
        },
        "days": {
          "type": "int",
          "default": 5,
          "min": 1,
          "max": 365,
          "label": "Days needed"
        },
        "done": {
          "type": "int",
          "default": 0,
          "min": 0,
          "label": "Days worked"
        },
        "status": {
          "type": "enum",
          "values": [
            "working",
            "finished",
            "dropped"
          ],
          "default": "working",
          "label": "Status"
        }
      }
    }
  },
  "recordActions": [
    {
      "id": "start",
      "label": "Start a project",
      "by": "owner",
      "record": "project",
      "do": "create",
      "ask": [
        "item",
        "tool",
        "cost",
        "days"
      ],
      "effect": {
        "chat": "{name} starts crafting {project.item}."
      }
    },
    {
      "id": "work",
      "label": "Add work days",
      "by": "gm",
      "record": "project",
      "do": "add",
      "field": "done",
      "amount": "ask",
      "where": {
        "status": "working"
      }
    },
    {
      "id": "drop",
      "label": "Drop it",
      "by": "owner",
      "record": "project",
      "do": "set",
      "set": {
        "status": "dropped"
      },
      "where": {
        "status": "working"
      }
    }
  ],
  "timers": [
    {
      "id": "progress",
      "record": "project",
      "on": "longRest",
      "where": {
        "status": "working"
      },
      "field": "done",
      "add": 1,
      "goal": "days",
      "done": {
        "set": {
          "status": "finished"
        },
        "chat": "{name} finishes crafting {project.item}!"
      }
    }
  ],
  "views": [
    {
      "id": "mine",
      "title": "Crafting",
      "record": "project",
      "place": "sheet",
      "columns": [
        "item",
        "done",
        "days"
      ],
      "where": {
        "status": "working"
      },
      "actions": [
        "drop"
      ]
    },
    {
      "id": "gm",
      "title": "Crafting",
      "record": "project",
      "place": "gm",
      "columns": [
        "item",
        "tool",
        "cost",
        "done",
        "days",
        "status"
      ],
      "actions": [
        "work"
      ],
      "groupByPlayer": true
    }
  ],
  "rules": [
    {
      "term": "Crafting projects (house rule)",
      "text": "Start a project with the right **tools**, paying **half the item's price** in materials. Each **long rest** spent working adds a day; the GM can add more for downtime. When the days are done the item is yours."
    }
  ],
  "assistant": {
    "words": [
      "craft",
      "crafting",
      "make an item",
      "forge",
      "brew"
    ],
    "gm": "Crafting projects are on: a project needs the right tools and half the item's price in materials; it gains a day per long rest and the GM can add days for downtime. Suggest days by price: about 1 day per 50 gp of the item's value, minimum 1.",
    "player": "Players can start crafting projects with the right tools and half the item's price in gold. Each long rest of work adds a day. Help pick a fitting item and tool."
  }
}
