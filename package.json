{
  "name": "alexandria-root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "librarian",
    "packages/*"
  ],
  "scripts": {
    "dev:librarian": "npm --prefix librarian run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix librarian start",
    "test": "npm --prefix librarian test && npm --prefix web run check"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
