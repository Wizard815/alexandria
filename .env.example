# Settings for the root docker-compose.yml (home / LAN, plain HTTP on one port).
#   cp .env.example .env
# For a server with a domain and HTTPS use deploy/.env.example instead.

# Port on this machine
LIBRARIAN_PORT=8090

# Folder of Markdown vaults (Obsidian, Lokus, Otterly) the admin may add as
# sources. Mounted read-only.
VAULTS_DIR=./vaults

# Base image for the build; a mirror helps if Docker Hub rate-limits you
# NODE_IMAGE=mirror.gcr.io/library/node:24-alpine
